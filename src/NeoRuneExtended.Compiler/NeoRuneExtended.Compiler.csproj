<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UAssetAPI" HintPath="$(RepoRoot)lib/UAssetAPI/UAssetAPI.dll" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <ProjectReference Include="../NeoRuneExtended.Assets/NeoRuneExtended.Assets.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The main-menu mark compiled into every mod: mod code (UE.* types), so not part of the compiler itself. -->
    <Compile Remove="NeoRune.Embedded.NeoRuneMark.cs" />
    <EmbeddedResource Include="NeoRune.Embedded.NeoRuneMark.cs" LogicalName="NeoRune.Embedded.NeoRuneMark.cs" />
  </ItemGroup>
</Project>
